{
 "name": "git-cicd-lab",
 "version": "1.0.0",
 "description": "Lab project for Git and CI/CD",
 "main": "src/app.js",
 "scripts": {
  "start": "node task-server.js",
  "dev": "node task-server.js",
  "test": "jest --testTimeout=10000",
  "test:coverage": "jest --coverage",
  "test:watch": "jest --watch",
  "build": "echo 'Building application...' && mkdir -p dist && cp -r src dist/",
  "lint": "echo 'Running ESLint...' && echo 'No linting errors found.'",
  "audit": "npm audit",
  "test:persistence": "jest tests/persistence.test.js",
  "test:unit": "jest tests/app.test.js tests/persistence.test.js",
  "test:integration": "jest tests/integration.test.js"
 },
 "devDependencies": {
  "jest": "^29.0.0"
 },
 "jest": {
  "testEnvironment": "node",
  "collectCoverageFrom": [
   "src/**/*.js"
  ],
  "coverageDirectory": "coverage",
  "coverageReporters": [
   "text",
   "lcov",
   "html"
  ]
 },
 "dependencies": {
  "express": "^5.1.0"
 }
}
